# 以下都是選用的環境變數，列出的值就是預設值。兩個服務都直接讀環境變數，不會自動載入 .env 檔。

# --- mcp-server ---
# Financial Engine 的位址
STOCKMIND_ENGINE_URL=http://127.0.0.1:8000

# --- financial-engine ---
# 對外部資料來源單次請求的逾時秒數、失敗後重試次數、重試間隔基準秒數
STOCKMIND_HTTP_TIMEOUT=10
STOCKMIND_HTTP_RETRIES=2
STOCKMIND_HTTP_BACKOFF=0.5
# 對交易所網站連續請求的最小間隔秒數；調太低可能被交易所暫時封鎖
STOCKMIND_THROTTLE_INTERVAL=1.5
# 公司基本資料、當日行情的記憶體快取秒數
STOCKMIND_SECURITIES_TTL=21600
STOCKMIND_QUOTES_TTL=300
# 已定案歷史資料的磁碟快取目錄；預設為 financial-engine/.cache，設成空字串則不存磁碟
# STOCKMIND_CACHE_DIR=
