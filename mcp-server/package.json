{
  "name": "stockmind-mcp-server",
  "version": "0.1.0",
  "description": "StockMind：台股研究 MCP Server（Tools／Resources／Prompts）",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stockmind-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector@latest node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
